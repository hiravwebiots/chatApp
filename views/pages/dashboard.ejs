          <!-- file preview -->
          <div id="filePreview" style="display:none; position:absolute; bottom: 70px; left: 15px; z-index: 1000; background: #fff; padding: 10px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.15);">
          
        </div>
        
        




   



        <!-- Reply Box -->
        <div class="row reply">
          <div class="col-sm-1 col-xs-1 reply-emojis">
            <i class="fa fa-smile-o fa-2x"></i>
          </div>
          <div class="col-sm-9 col-xs-9 reply-main">
            <textarea class="form-control" rows="1" id="messageInput" placeholder="Message"></textarea>
          </div>
            <!-- <div class="col-sm-1 col-xs-1 reply-recording">
              <i class="fa fa-microphone fa-2x" aria-hidden="true"></i>
            </div> -->

          <div class="col-sm-1 col-xs-1 reply-recording">
            <label for="fileInput" style="cursor:pointer;">
              <i class="fa fa-paperclip fa-2x"></i>
            </label>
            <input type="file" id="fileInput" style="display:none;">
          </div>


          
          <div class="col-sm-1 col-xs-1 reply-send">
              <i id="sendBtn" class="fa fa-send fa-2x" aria-hidden="true"></i>
