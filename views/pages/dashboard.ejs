  <!-- App End -->

        <!-- Include the head partial for meta tags, CSS links, etc. -->
        
        <script>
          const userId = "<%= currentUser.id %>"
          console.log('~dashboard ~ userId', userId);
        </script>


        <script>
          const currentUser = JSON.parse('<%- JSON.stringify(currentUser || {}) %>');
          // console.log("currentUser TYPE:", typeof currentUser);
          // console.log("currentUser FULL OBJECT:", currentUser);
          // console.log("currentUser PHOTO VALUE:", currentUser.profilePhoto);
        </script>


        <!-- Incoming Call Popup -->
        <div id="incomingCallUI" class="call-ui">
          <div class="call-card">
            
            <div id="callType" class="callTypeMessage"></div>

            <div id="callErrorMessage" class="callErrMessage"></div>


            <div class="avatar" id="callAvatar">DM</div>

            <!-- Dynamic Name -->
            <h2 id="callerName"></h2>

            <p class="call-status" id="callStatus">CALLING...</p>

            <div class="call-actions">
              <!-- Accept (only for receiver) -->
              <button id="acceptBtn" class="circle-btn accept">
                📞
              </button>

              <!-- Decline (both) -->
              <button id="declineBtn" class="circle-btn decline">
                📞
              </button>
            </div>
          </div>
        </div>
        
        <!-- ringtone -->
        <audio id="myRingtone" loop>
          <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3" type="audio/mpeg">
        </audio>

        <!-- Call Screen -->
        <div id="callScreen" class="call-ui">
          <div class="call-card">
            <!-- Avatar -->
            <div class="avatar" id="inCallAvatar">DM</div>
            <!-- Name -->
            <h2 id="inCallName"></h2>
            <!-- Status -->
            <p class="call-status" id="callTimer">00:00</p>
            <!-- Controls -->
            <div class="call-actions">
              <button id="muteAudioBtn" class="circle-btn">🎤</button>
              <button id="endAudioCallBtn" class="circle-btn decline">📞</button>
            </div>
          </div>
        </div>




        <!-- Video Call Screen -->
        <div id="videoCallScreen" class="call-ui">
          <div class="video-container">

            <!-- Remote Video (Other User) -->
            <video id="remoteVideo" autoplay playsinline></video>

            <!-- Local Video (Your Camera - small preview) -->
            <video id="localVideo" autoplay muted playsinline class="local-video"></video>

            <!-- Top Info -->
            <div class="video-header">
              <div class="avatar" id="videoAvatar">DM</div>
              <div>
                <h3 id="videoUserName"></h3>
                <p id="videoCallTimer">00:00</p>
              </div>
            </div>

            <!-- Controls -->
            <div class="video-controls">
              <button id="toggleVideoBtn" class="circle-btn">📷</button>
              <button id="muteVideoBtn" class="circle-btn">🎤</button>
              <button id="endVideoCallBtn" class="circle-btn decline">📞</button>
            </div>

          </div>
        </div>


</body>




